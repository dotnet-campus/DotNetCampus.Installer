<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>5.1</SupportedOSPlatformVersion>
    <RootNamespace>DotNetCampus.Installer.AvaloniaClassic</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="dotnetCampus.Configurations" Version="1.9.1" />
    <PackageReference Include="DotNetCampus.SourceLocalizations" Version="0.1.1-alpha.6" />
    <ProjectReference Include="../DotNetCampus.Installer.Lib/DotNetCampus.Installer.Lib.csproj" />
    <Compile Include="../DotNetCampus.Installer.AvaloniaClassic/Infrastructure/*.cs" Link="Infrastructure/%(Filename)%(Extension)" />
    <Compile Include="../DotNetCampus.Installer.AvaloniaClassic/InstallerPrograms/*.cs" Link="InstallerPrograms/%(Filename)%(Extension)" />
    <Compile Include="../DotNetCampus.Installer.AvaloniaClassic/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../DotNetCampus.Installer.AvaloniaClassic/LocalizedText.cs" Link="LocalizedText.cs" />
    <AdditionalFiles Include="../DotNetCampus.Installer.AvaloniaClassic/Localizations/*.toml" Link="Localizations/%(Filename)%(Extension)" SourceItemGroup="DotNetCampusLocalization" />
  </ItemGroup>
</Project>
