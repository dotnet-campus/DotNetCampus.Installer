<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>5.1</SupportedOSPlatformVersion>
    <RootNamespace>DotNetCampus.Installer.AvaloniaClassic</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="dotnetCampus.Configurations" Version="1.9.1" />
    <PackageReference Include="DotNetCampus.SourceLocalizations" Version="0.1.1-alpha.6" />
    <ProjectReference Include="../DotNetCampus.Installer.Lib/DotNetCampus.Installer.Lib.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugNativeRuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</DebugNativeRuntimeIdentifier>
    <DebugNativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</DebugNativeRuntimeIdentifier>
    <DebugNativeRuntimeIdentifier Condition="'$(Platform)' == 'x86' or '$(PlatformTarget)' == 'x86'">win-x86</DebugNativeRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Update="DebugContent/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" GeneratePathProperty="true" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.1" GeneratePathProperty="true" />
    <None Include="$(PkgSkiaSharp_NativeAssets_Win32)/runtimes/$(DebugNativeRuntimeIdentifier)/native/libSkiaSharp.dll" Link="DebugContent/libSkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="$(PkgHarfBuzzSharp_NativeAssets_Win32)/runtimes/$(DebugNativeRuntimeIdentifier)/native/libHarfBuzzSharp.dll" Link="DebugContent/libHarfBuzzSharp.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>