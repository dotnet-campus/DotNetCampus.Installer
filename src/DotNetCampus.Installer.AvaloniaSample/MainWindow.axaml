<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DotNetCampus.Installer.AvaloniaSample.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DotNetCampus.Installer.AvaloniaSample.MainWindow"
		Width="540" Height="326"
		CanResize="False"
        Title="Installer"
        SystemDecorations="None" ExtendClientAreaToDecorationsHint="true">
    <Grid>
		<Grid RowDefinitions="Auto,*,62">
			<Grid>
				<Border Width="32" Height="32" Background="Gray"
                        HorizontalAlignment="Left">
					<!-- 图标 -->
                </Border>
            </Grid>
			
            <Border Grid.Row="0" Width="32" Height="32" Background="Gray"
                    HorizontalAlignment="Right">
                <!-- 关闭窗口 -->
            </Border>

            <Border Grid.Row="1" Margin="10,10,10,10" Background="Aqua">
                <!-- 中间的大图 -->
            </Border>

			<!-- 安装条 -->
			<views:InstallBarUserControl x:Name="InstallBar" Grid.Row="2"/>

			<views:InstallStatusUserControl x:Name="InstallStatusControl" Grid.Row="2" IsVisible="False"/>

			<views:InstallFinishUserControl x:Name="InstallFinishControl" Grid.Row="2" IsVisible="False" OnFinish="InstallFinishControl_OnOnFinish"/>
        </Grid>
    </Grid>
</Window>
