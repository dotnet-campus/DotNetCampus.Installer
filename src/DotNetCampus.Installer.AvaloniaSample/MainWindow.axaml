<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DotNetCampus.Installer.AvaloniaSample.ViewModels"
        xmlns:views="clr-namespace:DotNetCampus.Installer.AvaloniaSample.Views"
        mc:Ignorable="d"
        d:DesignWidth="540"
        d:DesignHeight="326"
        x:Class="DotNetCampus.Installer.AvaloniaSample.MainWindow"
        x:DataType="viewModels:MainViewModel"
        Width="600"
        Height="376"
        CanResize="False"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="None"
        Title="Installer">
    <Border Margin="12" Classes="window-shell">
        <Grid RowDefinitions="56,*,72">
            <Border Grid.Row="0" Background="Transparent" PointerPressed="TitleBar_OnPointerPressed">
                <Grid Margin="20,16,16,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="12" Background="{StaticResource InstallerAccentBrush}">
                        <Grid>
                            <Border Margin="8" CornerRadius="6" Background="#33FFFFFF"/>
                            <Border Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="3" Background="White"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding ProductName}"/>
                        <TextBlock Classes="caption" Text="现代化安装体验"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Classes="icon-button" Click="MinimizeButton_OnClick">
                            <Path Classes="window-action-icon" Data="M1,5 L9,5 9,6 1,6 Z"/>
                        </Button>
                        <Button Classes="icon-button danger" Click="CloseButton_OnClick">
                            <Path Classes="window-action-icon" Data="M1.5,2.2 2.2,1.5 5,4.3 7.8,1.5 8.5,2.2 5.7,5 8.5,7.8 7.8,8.5 5,5.7 2.2,8.5 1.5,7.8 4.3,5 Z"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,6,20,14" ColumnDefinitions="1.25*,0.95*" ColumnSpacing="16">
                <Border Classes="card hero-panel" Padding="18">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                        <Border Classes="badge" HorizontalAlignment="Left">
                            <TextBlock Classes="caption" Foreground="White" Text="安装向导"/>
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Classes="hero-title" Text="{Binding InstallHeadline}"/>
                            <TextBlock Classes="hero-subtitle" Text="{Binding InstallDescription}"/>
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,6,0,0">
                            <Border Grid.Column="0" Classes="feature-card">
                                <StackPanel Spacing="6">
                                    <Ellipse Classes="accent-dot"/>
                                    <TextBlock Classes="section-title" FontSize="13" Text="快速部署"/>
                                    <TextBlock Classes="caption" Text="自动清理旧版本并完成替换。" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="feature-card">
                                <StackPanel Spacing="6">
                                    <Ellipse Classes="success-dot"/>
                                    <TextBlock Classes="section-title" FontSize="13" Text="真实进度"/>
                                    <TextBlock Classes="caption" Text="按实际文件释放进度实时更新。" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="feature-card">
                                <StackPanel Spacing="6">
                                    <Ellipse Classes="accent-dot" Fill="#47D1C9"/>
                                    <TextBlock Classes="section-title" FontSize="13" Text="系统接入"/>
                                    <TextBlock Classes="caption" Text="安装完成后自动写入快捷方式。" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3" Classes="stat-card" Margin="0,2,0,0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="安装位置"/>
                                    <TextBlock Classes="metric-value" Text="{Binding InstallPath}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                    <TextBlock Classes="caption" Text="版本" HorizontalAlignment="Right"/>
                                    <TextBlock Classes="metric-value" Text="{Binding AppVersion}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card" Padding="18">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="section-title" Text="安装概览"/>
                            <TextBlock Classes="caption" Text="持续显示当前安装阶段和目标信息。"/>
                        </StackPanel>

                        <Border Grid.Row="1" Classes="stat-card" Height="64">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Width="48" Height="48" CornerRadius="14" Background="#263F6F">
                                    <Grid>
                                        <Border Width="24" Height="24" CornerRadius="8" Background="#3A5FA1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border Width="10" Height="10" CornerRadius="3" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Classes="caption" Text="当前阶段"/>
                                    <TextBlock Classes="strong-label" Text="{Binding InstallStepText}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Classes="stat-card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Classes="caption" Text="总体进度"/>
                                    <TextBlock Classes="progress-value" Text="{Binding InstallProgressText}"/>
                                </Grid>
                                <ProgressBar Maximum="100" Value="{Binding InstallProgress}"/>
                                <TextBlock Classes="caption" Text="{Binding InstallDetailText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="3" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Ellipse Classes="accent-dot" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="caption" Text="安装路径"/>
                                    <TextBlock Text="{Binding InstallLocationHint}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Ellipse Classes="success-dot" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="caption" Text="当前文件"/>
                                    <TextBlock Text="{Binding CurrentFileDisplayName}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Ellipse Classes="accent-dot" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="caption" Text="系统接入"/>
                                    <TextBlock Text="注册信息与快捷方式将在安装尾声自动完成。" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Classes="caption" Text="安装期间界面会与安装程序状态保持同步。"/>
                    </Grid>
                </Border>
            </Grid>

            <views:InstallBarUserControl x:Name="InstallBar" Grid.Row="2"/>
            <views:InstallStatusUserControl x:Name="InstallStatusControl" Grid.Row="2" IsVisible="False"/>
            <views:InstallFinishUserControl x:Name="InstallFinishControl" Grid.Row="2" IsVisible="False" OnFinish="InstallFinishControl_OnOnFinish"/>
        </Grid>
    </Border>
</Window>
