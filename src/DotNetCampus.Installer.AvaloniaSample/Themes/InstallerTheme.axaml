<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="InstallerAccentColor">#5B8CFF</Color>
    <Color x:Key="InstallerAccentSoftColor">#2D4F8A</Color>
    <Color x:Key="InstallerSuccessColor">#35C78A</Color>
    <Color x:Key="InstallerDangerColor">#FF6A7E</Color>
    <Color x:Key="InstallerWindowBackgroundColor">#0C1424</Color>
    <Color x:Key="InstallerSurfaceColor">#111C33</Color>
    <Color x:Key="InstallerSurfaceMutedColor">#17243F</Color>
    <Color x:Key="InstallerBorderColor">#334669</Color>
    <Color x:Key="InstallerTextPrimaryColor">#F4F8FF</Color>
    <Color x:Key="InstallerTextSecondaryColor">#A5B5D6</Color>
    <Color x:Key="InstallerTextMutedColor">#7183A9</Color>
    <SolidColorBrush x:Key="InstallerAccentBrush" Color="{StaticResource InstallerAccentColor}" />
    <SolidColorBrush x:Key="InstallerSuccessBrush" Color="{StaticResource InstallerSuccessColor}" />
    <SolidColorBrush x:Key="InstallerDangerBrush" Color="{StaticResource InstallerDangerColor}" />
    <SolidColorBrush x:Key="InstallerWindowBackgroundBrush" Color="{StaticResource InstallerWindowBackgroundColor}" />
    <SolidColorBrush x:Key="InstallerSurfaceBrush" Color="{StaticResource InstallerSurfaceColor}" />
    <SolidColorBrush x:Key="InstallerSurfaceMutedBrush" Color="{StaticResource InstallerSurfaceMutedColor}" />
    <SolidColorBrush x:Key="InstallerBorderBrush" Color="{StaticResource InstallerBorderColor}" />
    <SolidColorBrush x:Key="InstallerTextPrimaryBrush" Color="{StaticResource InstallerTextPrimaryColor}" />
    <SolidColorBrush x:Key="InstallerTextSecondaryBrush" Color="{StaticResource InstallerTextSecondaryColor}" />
    <SolidColorBrush x:Key="InstallerTextMutedBrush" Color="{StaticResource InstallerTextMutedColor}" />
    <LinearGradientBrush x:Key="InstallerHeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1E3B6A" Offset="0" />
      <GradientStop Color="#142540" Offset="0.55" />
      <GradientStop Color="#0F1930" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InstallerAccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#63A0FF" Offset="0" />
      <GradientStop Color="#47D1C9" Offset="1" />
    </LinearGradientBrush>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource InstallerWindowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InstallerTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="Inter" />
  </Style>
  <Style Selector="Border.window-shell">
    <Setter Property="Background" Value="#B80A1120" />
    <Setter Property="BorderBrush" Value="#3C4B69" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BoxShadow" Value="0 18 48 0 #44000000" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource InstallerSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InstallerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>
  <Style Selector="Border.hero-panel">
    <Setter Property="Background" Value="{StaticResource InstallerHeroBackgroundBrush}" />
  </Style>
  <Style Selector="Border.footer-panel">
    <Setter Property="Background" Value="#CC101B31" />
    <Setter Property="BorderBrush" Value="#40506F" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="CornerRadius" Value="18,18,24,24" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="#333965FF" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.feature-card">
    <Setter Property="Background" Value="#401A2B4A" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BorderBrush" Value="#335470A0" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.stat-card">
    <Setter Property="Background" Value="{StaticResource InstallerSurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InstallerTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource InstallerTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.hero-title">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.hero-subtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InstallerTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.metric-value">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.strong-label">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.progress-value">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource InstallerSurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InstallerTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InstallerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="#203357" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="#152846" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource InstallerAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InstallerAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="#76A5FF" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#18263F" />
  </Style>
  <Style Selector="Button.icon-button">
    <Setter Property="Background" Value="#182235" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="#402130" />
    <Setter Property="BorderBrush" Value="{StaticResource InstallerDangerBrush}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="#16233B" />
    <Setter Property="Foreground" Value="{StaticResource InstallerTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InstallerBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="SelectionBrush" Value="#665B8CFF" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource InstallerAccentGradientBrush}" />
    <Setter Property="Background" Value="#18253B" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Ellipse.accent-dot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Fill" Value="{StaticResource InstallerAccentBrush}" />
  </Style>
  <Style Selector="Ellipse.success-dot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Fill" Value="{StaticResource InstallerSuccessBrush}" />
  </Style>
  <Style Selector="Path.window-action-icon">
    <Setter Property="Fill" Value="{StaticResource InstallerTextSecondaryBrush}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
</Styles>

