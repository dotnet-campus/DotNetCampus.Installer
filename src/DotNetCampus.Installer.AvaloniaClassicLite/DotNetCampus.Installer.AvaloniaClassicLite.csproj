<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>../DotNetCampus.Installer.AvaloniaClassic/app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="dotnetCampus.Configurations" Version="1.9.1" />
    <PackageReference Include="DotNetCampus.SourceLocalizations" Version="0.1.1-alpha.6" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" Version="0.3.264" />
    <ProjectReference Include="../DotNetCampus.Installer.Lib/DotNetCampus.Installer.Lib.csproj" />
    <Compile Include="../DotNetCampus.Installer.AvaloniaClassic/Program.cs" Link="Program.cs" />
    <Compile Include="../DotNetCampus.Installer.AvaloniaClassic/Infrastructure/*.cs" Link="Infrastructure/%(Filename)%(Extension)" />
    <Compile Include="../DotNetCampus.Installer.AvaloniaClassic/InstallerPrograms/*.cs" Link="InstallerPrograms/%(Filename)%(Extension)" />
    <Compile Include="../DotNetCampus.Installer.AvaloniaClassic/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../DotNetCampus.Installer.AvaloniaClassic/LocalizedText.cs" Link="LocalizedText.cs" />
    <AdditionalFiles Include="../DotNetCampus.Installer.AvaloniaClassic/NativeMethods.txt" />
    <AdditionalFiles Include="../DotNetCampus.Installer.AvaloniaClassic/Localizations/*.toml" Link="Localizations/%(Filename)%(Extension)" SourceItemGroup="DotNetCampusLocalization" />
    <AvaloniaResource Include="Resources/Strings.resx" />
  </ItemGroup>
</Project>
