<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DotNetCampus.Installer.AvaloniaClassic.Views.InstallerNavigationControl">
    <Border BorderBrush="#CCD2D6" BorderThickness="0,1,0,0" Background="#F4F7F9">
        <Grid Margin="18,9" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="9">
            <StackPanel x:Name="InstallationFolderPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Spacing="0">
                    <TextBlock Text="Installation Folder" FontSize="10" />
                    <TextBox x:Name="InstallationFolderTextBox"
                             Width="310"
                             Height="25"
                             FontSize="11"
                             Text="C:\Program Files\Generic Software" />
                </StackPanel>
                <Button VerticalAlignment="Bottom" Content="Browse..." Click="BrowseButton_OnClick" />
            </StackPanel>
            <Button Grid.Column="2" Content="Cancel" Click="CancelButton_OnClick" />
            <Button x:Name="BackButton" Grid.Column="3" Content="Back" IsVisible="False" Click="BackButton_OnClick" />
            <Button x:Name="NextButton" Grid.Column="4" Classes="primary" Content="Next &gt;" Click="NextButton_OnClick" />
            <Button x:Name="FinishButton" Grid.Column="4" Content="完成" IsEnabled="False" IsVisible="False" Click="FinishButton_OnClick" />
        </Grid>
    </Border>
</UserControl>
