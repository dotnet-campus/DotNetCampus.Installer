<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DotNetCampus.Installer.AvaloniaClassic.ViewModels"
             x:Class="DotNetCampus.Installer.AvaloniaClassic.Views.InstallerBrandingControl"
             x:DataType="viewModels:MainWindowViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Canvas Width="86" Height="78">
            <Polygon Points="18,34 43,20 68,34 43,49" Fill="#A8C9ED" Stroke="#3974AE" StrokeThickness="1.3" />
            <Polygon Points="18,34 43,49 43,69 18,54" Fill="#8EB7E3" Stroke="#3974AE" StrokeThickness="1.3" />
            <Polygon Points="43,49 68,34 68,54 43,69" Fill="#6F9FD0" Stroke="#3974AE" StrokeThickness="1.3" />
            <Polygon Points="31,18 43,11 55,18 43,25" Fill="#D4E5F7" Stroke="#3974AE" StrokeThickness="1.2" />
            <Polygon Points="31,18 43,25 43,39 31,32" Fill="#AECDEC" Stroke="#3974AE" StrokeThickness="1.2" />
            <Polygon Points="43,25 55,18 55,32 43,39" Fill="#88B1DD" Stroke="#3974AE" StrokeThickness="1.2" />
        </Canvas>
        <TextBlock Text="{Binding WelcomeText}"
                   FontSize="18"
                   LineHeight="21"
                   TextAlignment="Center" />
    </StackPanel>
</UserControl>
