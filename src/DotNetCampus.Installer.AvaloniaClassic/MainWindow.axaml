<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DotNetCampus.Installer.AvaloniaClassic.Views"
        xmlns:viewModels="clr-namespace:DotNetCampus.Installer.AvaloniaClassic.ViewModels"
        x:Class="DotNetCampus.Installer.AvaloniaClassic.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Width="720"
        Height="450"
        MinWidth="720"
        MinHeight="450"
        MaxWidth="720"
        MaxHeight="450"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        Title="{Binding WindowTitle}">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#171717" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="14,3" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3478C3" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2869AE" />
        </Style>
        <Style Selector="Border.content-card">
            <Setter Property="Background" Value="#FCFDFD" />
            <Setter Property="BorderBrush" Value="#C8CFD3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,58">
        <Grid Grid.Row="0" ColumnDefinitions="210,*" Margin="20,20,20,16" ColumnSpacing="16">
            <views:InstallerBrandingControl Grid.Column="0" />
            <views:PrepareInstallControl Grid.Column="1" IsVisible="{Binding IsPreparing}" />
            <views:InstallProgressControl Grid.Column="1" IsVisible="{Binding !IsPreparing}" />
        </Grid>

        <views:InstallerNavigationControl Grid.Row="1" />
    </Grid>
</Window>
