<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:DotNetCampus.Installer.AvaloniaClassicSimple"
        x:Class="DotNetCampus.Installer.AvaloniaClassicSimple.MainWindow" x:DataType="local:InstallerViewModel"
        Width="728" Height="450" CanResize="False" Background="White" FontFamily="Segoe UI" FontSize="18" Title="{Binding WindowTitle}">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Width" Value="111"/><Setter Property="Height" Value="33"/><Setter Property="Padding" Value="6,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Background" Value="#FDFDFD"/><Setter Property="BorderBrush" Value="#CDCDCD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="32"/><Setter Property="Foreground" Value="#707070"/></Style>
  </Window.Styles>
  <Grid x:Name="ClientArea">
    <Image Width="92" Height="92" Margin="19,19,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{Binding ProductIcon}"/>
    <TextBlock Text="{Binding ProductName}" FontSize="36" Margin="120,21,17,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
    <Grid x:Name="LicensePage" IsVisible="{Binding IsLicense}">
      <Border Margin="17,120,17,105" BorderBrush="#777777" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Visible"><TextBlock Text="{Binding LicenseText}" FontSize="20" TextWrapping="Wrap" Margin="4,16,12,8"/></ScrollViewer>
      </Border>
      <CheckBox x:Name="LicenseAgreement" Content="{Binding AgreementText}" IsChecked="{Binding HasAcceptedLicense, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,357,35,0" MinHeight="32" Padding="5,0"/>
      <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18">
        <Button x:Name="OptionsButton" Content="{Binding OptionsText}" Click="OptionsClicked"/>
        <Button x:Name="InstallButton" Content="{Binding InstallText}" IsEnabled="{Binding CanInstall}" Click="InstallClicked"/>
        <Button Content="{Binding CancelText}" Click="CancelClicked"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="OptionsPage" IsVisible="{Binding IsOptions}">
      <TextBlock Classes="heading" Text="{Binding OptionsTitle}" Margin="17,125,17,0" VerticalAlignment="Top"/>
      <TextBlock Text="{Binding LocationText}" Margin="17,186,0,0" VerticalAlignment="Top"/>
      <Grid Margin="17,214,18,0" Height="33" VerticalAlignment="Top" ColumnDefinitions="*,9,111">
        <TextBox x:Name="PathEditor" Text="{Binding DraftPath, Mode=TwoWay}" FontSize="18" Padding="8,2" MinHeight="0"/>
        <Button Grid.Column="2" Content="{Binding BrowseText}" Click="BrowseClicked"/>
      </Grid>
      <TextBlock Text="{Binding Error}" Foreground="#B00020" TextWrapping="Wrap" Margin="17,260,18,60"/>
      <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18">
        <Button Content="{Binding OkText}" Click="OkClicked"/>
        <Button Content="{Binding CancelText}" Click="CancelClicked"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="ProgressPage" IsVisible="{Binding IsProgress}">
      <TextBlock Classes="heading" Text="{Binding ProgressTitle}" Margin="17,125,17,0" VerticalAlignment="Top"/>
      <Grid Margin="17,186,18,0" VerticalAlignment="Top" ColumnDefinitions="111,*">
        <TextBlock Text="{Binding ProcessingText}"/><TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <ProgressBar x:Name="InstallationProgress" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="23" Margin="17,215,17,0" VerticalAlignment="Top" Foreground="#0D7B0D" Background="#E6E6E6" BorderBrush="#BDBDBD" BorderThickness="1"/>
      <Button Content="{Binding CancelText}" Click="CancelClicked" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"/>
    </Grid>
    <Grid x:Name="FinishedPage" IsVisible="{Binding IsFinished}">
      <TextBlock Classes="heading" Text="{Binding Result}" Margin="17,125,17,0" VerticalAlignment="Top" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Error}" Foreground="#B00020" TextWrapping="Wrap" Margin="17,220,18,60"/>
      <Button Content="{Binding CloseText}" Click="CancelClicked" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"/>
    </Grid>
  </Grid>
</Window>
